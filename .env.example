# Copy from Desktop/env.txt and strip spaces around '='
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
HUGGING_FACE_HUB_TOKEN=
FAL_API_KEY=
# fal SDK also accepts FAL_KEY= (same value)

# OmniRoute (ComicEngine scripts) — same key as Cursor Models → OpenAI API Key when base is :20128/v1
USE_OMNIROUTE=1
OMNIROUTE_BASE_URL=http://127.0.0.1:20128
OMNIROUTE_API_KEY=
OMNIROUTE_ANTHROPIC_MODEL=auto/cheap
OMNIROUTE_OPENAI_MODEL=auto/cheap
OMNIROUTE_SCRIPT_MODEL=auto/cheap
# Image gen + Gemini text: always direct from GOOGLE_API_KEY (never OmniRoute)

# optional overrides
USAGE_DB_PATH=data/usage.db
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765
PUBLIC_BASE_URL=http://127.0.0.1:8765

# Phase 8.6 — Google OAuth (see docs/BETA_SETUP.md)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_EMAILS=you@gmail.com
# Local-only owner console — leave at 0 so /admin stats work without login
BETA_REQUIRE_LOGIN=0

# Phase 10 — Cloudflare R2 / Pages
CF_ACCOUNT_ID=
CF_R2_ACCESS_KEY_ID=
CF_R2_SECRET_ACCESS_KEY=
CF_R2_BUCKET=comicengine-beta
CF_PAGES_PROJECT=comicengine-beta
BETA_PUBLISH_APPROVED_ONLY=1
