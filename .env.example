# Copy from Desktop/env.txt and strip spaces around '='
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
HUGGING_FACE_HUB_TOKEN=
FAL_API_KEY=

# OmniRoute (ComicEngine scripts) — same key as Cursor Models → OpenAI API Key when base is :20128/v1
USE_OMNIROUTE=1
OMNIROUTE_BASE_URL=http://127.0.0.1:20128
OMNIROUTE_API_KEY=
OMNIROUTE_ANTHROPIC_MODEL=auto/cheap
OMNIROUTE_OPENAI_MODEL=auto/cheap
OMNIROUTE_SCRIPT_MODEL=auto/cheap
# Image gen + Gemini text: always direct from GOOGLE_API_KEY (never OmniRoute)

# optional overrides
USAGE_DB_PATH=data/usage.db
DASHBOARD_PORT=8765
